# NVIDIA NIM API key (get from build.nvidia.com)
NVIDIA_API_KEY=nvapi-...

# Clerk keys (get from dashboard.clerk.com → API Keys)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# PostgreSQL connection string (local dev)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nerve

# Server port (default: 3001)
PORT=3001
